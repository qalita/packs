**/__pycache__/
# Local Python environments, tool caches, and build outputs are never pack
# assets. push_all_packs.sh stages the working tree through Git's ignore rules.
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/build/
**/dist/
**/*.egg-info/
target_conf.json
docker-compose.yml
metrics.json
recommendations.json
schemas.json
figures.json
source_conf.json
*.html
*_report.json
*.xlsx
*_metrics.json
*_recommendations.json
*_schemas.json
*_figures.json
*.log
*requirements.txt
*.csv
# ...except the OHDSI DataQualityDashboard check metadata vendored into
# omop_cdm_pack, which IS source: the whole check catalog is generated
# from these 8 files. Without this negation `git add` silently drops
# them and the refresh procedure in omop_dqd/vendor/README.md no-ops.
!omop_cdm_pack/omop_dqd/vendor/csv/*.csv

# Run scripts are copied from scripts/ by CI/CD - ignore in pack directories
*_pack/run.sh
*_pack/run.bat
*_pack/run.ps1
